# Copy to .env and adjust. Docker Compose reads it too.
# See docs/configuration.md for every setting.

# --- Required outside development ---------------------------------------------------------------
# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
EXAMPLE_SECRET_KEY=
EXAMPLE_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Development ----------------------------------------------------------------------------------
# EXAMPLE_DEBUG=true            # also relaxes the two required settings above
# EXAMPLE_HTTPS=false           # plain HTTP on your own machine
# EXAMPLE_LOG_LEVEL=INFO

# --- Database and cache ---------------------------------------------------------------------------
# SQLite is used when DATABASE_URL is not set. See docs/database.md.
# DATABASE_URL=postgres://user:password@localhost:5432/app
# DATABASE_URL=mysql://user:password@localhost:3306/app
# CACHE_URL=rediscache://localhost:6379/1
# POSTGRES_PASSWORD=example     # used by compose.yaml

# --- Optional features ----------------------------------------------------------------------------
# EXAMPLE_API_ENABLED=true
# EXAMPLE_UI_ENABLED=true
# EXAMPLE_ADMIN_ENABLED=true
# EXAMPLE_ADMIN_URL=admin/
# EXAMPLE_DOCS_ENABLED=true

# --- API authentication: none, session, api_key or jwt --------------------------------------------
# EXAMPLE_API_AUTH_MODE=session
# EXAMPLE_API_KEYS=change-me
# EXAMPLE_JWT_KEY=change-me
# EXAMPLE_JWT_ALGORITHM=HS256

# --- Server (example-serve) -----------------------------------------------------------------------
# EXAMPLE_SERVER=wsgi           # or asgi
# EXAMPLE_HOST=127.0.0.1
# EXAMPLE_PORT=8000
# EXAMPLE_WORKERS=1
# EXAMPLE_SHUTDOWN_TIMEOUT=10

# --- Behind a reverse proxy (see docs/deployment.md) ----------------------------------------------
# EXAMPLE_BEHIND_PROXY=true
# EXAMPLE_PROXY_COUNT=1
# EXAMPLE_FORWARDED_ALLOW_IPS=10.0.0.0/8
# EXAMPLE_CSRF_TRUSTED_ORIGINS=https://example.com
# EXAMPLE_CORS_ORIGINS=https://app.example.com
# EXAMPLE_ROOT_PATH=/myapp

# --- Hardening ------------------------------------------------------------------------------------
# EXAMPLE_RATE_LIMIT_PER_MINUTE=120   # 0 turns it off
# EXAMPLE_MAX_BODY_BYTES=1048576
